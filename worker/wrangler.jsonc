{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factcheck-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true }
  ],
  "kv_namespaces": [
    {
      "binding": "RESULTS",
      "id": "cccde252d50e41f193c27e473568205b"
    }
  ]
}
